{
  "name": "treads",
  "version": "1.5.2",
  "description": "A top down game of mini tanks",
  "keywords": [
    "game",
    "tanks",
    "strategy",
    "top-down",
    "2d",
    "typescript",
    "webpack"
  ],
  "homepage": "https://github.com/sparrill14/treads#readme",
  "bugs": {
    "url": "https://github.com/sparrill14/treads/issues"
  },
  "license": "MIT",
  "author": "Steven Parrill <sparrill14@gmail.com> (https://github.com/sparrill14)",
  "scripts": {
    "start": "webpack serve --open --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.dev.js",
    "build:prod": "webpack --config webpack.prod.js",
    "prebuild": "echo \"Build started ...\"",
    "postbuild": "echo \"Build completed successfully.\"",
    "test": "tsc -p tsconfig.test.json && node ./.test-dist/tests/run-tests.js",
    "lint": "eslint src/ training/ tests/ --ext .ts",
    "lint:py": "python -m compileall training",
    "build:training": "npx tsc -p training/tsconfig.training.json",
    "verify:training": "npm run build:training && npm run lint:py",
    "dashboard": "npm run build:training && node ./.training-dist/training/dashboard-server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparrill14/Treads.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.8.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@types/bootstrap": "^5.2.11",
    "@types/d3": "^7.4.3",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.6",
    "bootstrap": "^5.3.8",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "onnxruntime-web": "^1.27.0"
  }
}